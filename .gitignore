## Ignore Visual Studio temporary files, build results, and
## user-specific files.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Uncomment if you have tasks that create the following folders:
# publish/
# out/

# Visual Studio 2019/2022 config folders
.vs/
.vscode/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# StyleCop
StyleCopReport.xml

# File-based packages
*.nupkg
# The packages folder can be ignored because of PackageReference in newer .NET
**/packages/*
!**/packages/build/
!**/packages/repositories.config

# Others
*.cache
*.dll
*.exe
*.pdb
*.dbmdl
*.log

# Visual Studio profiler
*.vsp
*.vspx
*.sap

# TFS
$tf/

# Rider
.idea/
*.sln.iml

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# DotCover
*.dotCover

# Coverage reports
TestResults/
*.coverage
*.coveragexml
*.codecoverage

# Backup & generated files
*.orig
*.tmp
*.bak

# Local database files
*.mdf
*.ldf

# Publish Web Output
*.[Pp]ublish.xml
*.azurePubxml
# Docker
docker-compose.override.yml
